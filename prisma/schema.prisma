generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Page {
  id        String   @id @default(cuid())
  name      String
  template  String   @default("landing")
  sections  String   @default("[]")
  theme     String   @default("{}")
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  name      String
  type      String   // "theme" or "plugin"
  config    String   // JSON string of the full config object
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaItem {
  id         String   @id @default(cuid())
  name       String
  url        String   // File path relative to /uploads/ or original URL
  alt        String   @default("")
  caption    String   @default("")
  width      Int      @default(0)
  height     Int      @default(0)
  size       Int      @default(0)  // File size in bytes
  mimeType   String   @default("image/png")
  uploadedAt DateTime @default(now())
  data       String?  // Base64 data URL for images stored in DB (for small images)
}
